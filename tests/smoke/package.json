{
  "name": "@ai-swarm-qa/smoke-tests",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "lint": "tsc -p tsconfig.json --noEmit",
    "smoke": "tsx src/audit-smoke.ts",
    "smoke:planner": "tsx src/planner-smoke.ts success",
    "smoke:planner:fallback": "tsx src/planner-smoke.ts fallback",
    "smoke:planner:anthropic": "tsx src/planner-smoke.ts anthropic",
    "smoke:anthropic": "tsx src/anthropic-smoke.ts",
    "smoke:browser-agent": "tsx src/browser-agent-smoke.ts success",
    "smoke:browser-agent:anthropic": "tsx src/browser-agent-smoke.ts anthropic",
    "smoke:browser-agent:safety": "tsx src/browser-agent-smoke.ts safety",
    "smoke:swarm": "tsx src/swarm-smoke.ts success",
    "smoke:swarm:anthropic": "tsx src/swarm-smoke.ts anthropic",
    "smoke:swarm:safety": "tsx src/swarm-smoke.ts safety",
    "smoke:swarm:budget": "tsx src/swarm-smoke.ts budget",
    "smoke:github-export": "tsx src/github-export-smoke.ts",
    "test": "vitest run --passWithNoTests",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@ai-swarm-qa/ai": "workspace:*",
    "@ai-swarm-qa/config": "workspace:*",
    "@ai-swarm-qa/shared": "workspace:*",
    "zod": "4.4.3",
    "tsx": "4.23.1"
  },
  "devDependencies": {
    "@types/node": "26.1.1",
    "typescript": "5.9.3",
    "vitest": "4.1.10"
  }
}
