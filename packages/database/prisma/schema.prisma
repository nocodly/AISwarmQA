generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum Plan {
  FREE
  STARTER
  PRO
  TEAM
  ENTERPRISE
}

enum AuditStatus {
  CREATED
  VALIDATING
  QUEUED
  PLANNING
  RUNNING
  ANALYZING
  GENERATING_REPORT
  COMPLETED
  FAILED
  CANCELLED
}

enum MissionStatus {
  CREATED
  QUEUED
  RUNNING
  COMPLETED
  FAILED
  CANCELLED
  SKIPPED
}

enum BrowserSessionStatus {
  RUNNING
  COMPLETED
  FAILED
}

enum FindingSeverity {
  CRITICAL
  HIGH
  MEDIUM
  LOW
}

enum FindingCategory {
  FUNCTIONAL
  ACCESSIBILITY
  PERFORMANCE
  UX
  SECURITY
  NETWORK
  CONSOLE
}

enum GitHubAccountType {
  USER
  ORGANIZATION
}

enum GitHubExportStatus {
  QUEUED
  CREATING
  CREATED
  FAILED
  SKIPPED
}

enum GitHubExportBatchStatus {
  QUEUED
  RUNNING
  COMPLETED
  PARTIALLY_COMPLETED
  FAILED
  CANCELLED
}

enum CommercialPlan {
  FREE
  PRO
  BUSINESS
}

enum BillingInterval {
  MONTHLY
  YEARLY
  CONTACT
}

enum SubscriptionStatus {
  FREE
  TRIALING
  ACTIVE
  PAST_DUE
  UNPAID
  CANCELED
  INCOMPLETE
  INCOMPLETE_EXPIRED
}

enum UsageEventType {
  AUDIT_CREATED
  AUDIT_COMPLETED
  AUDIT_FAILED
  AUDIT_CANCELLED
  PAGE_SCANNED
  AI_REQUEST
  SCREENSHOT_CREATED
  STORAGE_BYTES
  GITHUB_ISSUE_EXPORTED
}

enum InvitationStatus {
  PENDING
  ACCEPTED
  REVOKED
  EXPIRED
}

enum WorkspaceDeletionStatus {
  REQUESTED
  BLOCKED
  PROCESSING
  COMPLETED
  FAILED
  CANCELLED
}

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  supabaseUserId String? @unique
  name      String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  memberships       OrganizationMember[]
  githubConnections GitHubConnection[]
  githubExportBatches GitHubExportBatch[]
  githubExports FindingGitHubExport[]
  githubAuthStates GitHubAuthState[]
  sentEmails EmailEvent[]
  workspaceInvitationsSent WorkspaceInvitation[] @relation("WorkspaceInvitationInviter")
  workspaceDeletionRequests WorkspaceDeletionRequest[]
  usageEvents WorkspaceUsageEvent[]
}

model Organization {
  id        String   @id @default(cuid())
  name      String
  plan      Plan     @default(FREE)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  members           OrganizationMember[]
  projects          Project[]
  githubConnections GitHubConnection[]
  githubAuthStates  GitHubAuthState[]
  billingCustomer   BillingCustomer?
  subscription      WorkspaceSubscription?
  usageEvents       WorkspaceUsageEvent[]
  invitations       WorkspaceInvitation[]
  onboarding        WorkspaceOnboarding?
  auditLogs         WorkspaceAuditLog[]
  deletionRequests  WorkspaceDeletionRequest[]
}

model OrganizationMember {
  id             String       @id @default(cuid())
  organizationId String
  userId         String
  role           String
  createdAt      DateTime     @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([organizationId, userId])
}

model Project {
  id             String   @id @default(cuid())
  organizationId String
  name           String
  targetUrl      String
  verifiedAt     DateTime?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  audits       Audit[]
}

model Audit {
  id            String      @id @default(cuid())
  projectId     String
  targetUrl     String
  status        AuditStatus @default(CREATED)
  correlationId String
  maxSteps      Int
  maxCostUsd    Decimal
  queuedAt      DateTime?
  startedAt     DateTime?
  completedAt   DateTime?
  failedAt      DateTime?
  failureReason String?
  actualCost    Decimal     @default(0)
  browserDurationMs Int?
  executionSummary Json?
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  project  Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  missions Mission[]
  findings Finding[]
  report   Report?
  plan     AuditPlan?
  browserAgentRuns BrowserAgentRun[]
  browserSwarmRuns BrowserSwarmRun[]
  githubExportBatches GitHubExportBatch[]
  githubExports FindingGitHubExport[]
  usageEvents WorkspaceUsageEvent[]
}

model AuditPlan {
  id                       String   @id @default(cuid())
  auditId                  String   @unique
  mode                     String
  source                   String
  status                   String
  provider                 String?
  model                    String?
  promptId                 String?
  promptVersion            String?
  baselinePlanJson         Json
  snapshotJson             Json?
  proposedPlanJson         Json?
  acceptedPlanJson         Json?
  rejectedProposalsJson    Json
  importantJourneysJson    Json
  websiteClassification    String?
  classificationConfidence Decimal?
  inputTokens              Int?
  outputTokens             Int?
  estimatedInputCost       Decimal?
  estimatedOutputCost      Decimal?
  estimatedCost            Decimal?
  durationMs               Int?
  fallbackReason           String?
  warningsJson             Json
  createdAt                DateTime @default(now())
  completedAt              DateTime?
  updatedAt                DateTime @updatedAt

  audit Audit @relation(fields: [auditId], references: [id], onDelete: Cascade)
}

model Mission {
  id          String        @id @default(cuid())
  auditId     String
  type        String
  role        String
  status      MissionStatus @default(CREATED)
  objective   String
  priority    Int           @default(100)
  required    Boolean       @default(true)
  attemptCount Int          @default(0)
  maxAttempts Int           @default(1)
  timeoutMs   Int           @default(45000)
  instructions Json
  resultSummary String?
  failureReason String?
  startedAt   DateTime?
  completedAt DateTime?
  failedAt    DateTime?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  audit           Audit            @relation(fields: [auditId], references: [id], onDelete: Cascade)
  browserSessions BrowserSession[]
  browserAgentRuns BrowserAgentRun[]
  browserSwarmAgents BrowserSwarmAgent[]

  @@unique([auditId, type])
}

model BrowserAgentRun {
  id               String   @id @default(cuid())
  auditId          String
  missionId        String
  swarmAgentId     String?
  status           String
  provider         String
  model            String?
  promptId         String
  promptVersion    String
  objective        String
  startUrl         String
  finalUrl         String?
  maxSteps         Int
  stepsUsed        Int      @default(0)
  providerCalls    Int      @default(0)
  inputTokens      Int?
  outputTokens     Int?
  estimatedCost    Decimal?
  startedAt        DateTime
  completedAt      DateTime?
  terminalReason   String?
  summary          String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  audit   Audit              @relation(fields: [auditId], references: [id], onDelete: Cascade)
  mission Mission            @relation(fields: [missionId], references: [id], onDelete: Cascade)
  steps   BrowserAgentStep[]

  @@unique([swarmAgentId])
  @@index([auditId])
  @@index([missionId])
}

model BrowserAgentStep {
  id                 String   @id @default(cuid())
  runId              String
  sequence           Int
  observationJson    Json
  proposedActionJson Json
  validationStatus   String
  safetyDecisionJson Json
  executionStatus    String
  executionResultJson Json
  urlBefore          String?
  urlAfter           String?
  stateChanged       Boolean  @default(false)
  inputTokens        Int?
  outputTokens       Int?
  estimatedCost      Decimal?
  durationMs         Int?
  startedAt          DateTime
  completedAt        DateTime?
  createdAt          DateTime @default(now())

  run BrowserAgentRun @relation(fields: [runId], references: [id], onDelete: Cascade)

  @@unique([runId, sequence])
  @@index([runId])
}

model BrowserSwarmRun {
  id                 String   @id @default(cuid())
  auditId            String
  status             String
  mode               String
  maxAgents          Int
  maxConcurrency     Int
  agentsCreated      Int      @default(0)
  agentsCompleted    Int      @default(0)
  totalSteps         Int      @default(0)
  totalProviderCalls Int      @default(0)
  totalInputTokens   Int?
  totalOutputTokens  Int?
  estimatedCost      Decimal?
  coverageStateJson  Json
  startedAt          DateTime
  completedAt        DateTime?
  terminalReason     String?
  summary            String?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  audit  Audit               @relation(fields: [auditId], references: [id], onDelete: Cascade)
  agents BrowserSwarmAgent[]

  @@index([auditId])
}

model BrowserSwarmAgent {
  id                String   @id @default(cuid())
  swarmRunId        String
  missionId         String
  browserAgentRunId String?
  role              String
  objective         String
  status            String
  priority          Int
  routesVisitedJson Json
  findingsCount     Int      @default(0)
  stepsUsed         Int      @default(0)
  startedAt         DateTime?
  completedAt       DateTime?
  terminalReason    String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  swarmRun BrowserSwarmRun @relation(fields: [swarmRunId], references: [id], onDelete: Cascade)
  mission  Mission         @relation(fields: [missionId], references: [id], onDelete: Cascade)

  @@unique([swarmRunId, role])
  @@unique([browserAgentRunId])
  @@index([missionId])
}

model BrowserSession {
  id          String   @id @default(cuid())
  missionId   String
  status      BrowserSessionStatus
  browser     String
  viewportWidth Int
  viewportHeight Int
  startedAt   DateTime
  completedAt DateTime?
  finalUrl    String?
  browserDurationMs Int?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  mission Mission @relation(fields: [missionId], references: [id], onDelete: Cascade)
}

model Finding {
  id               String          @id @default(cuid())
  auditId          String
  category         FindingCategory
  severity         FindingSeverity
  title            String
  summary          String
  description      String
  affectedUrl      String
  affectedUrls     Json
  stepsToReproduce Json
  expectedBehavior String
  actualBehavior   String
  evidenceIds      Json
  browser          String
  viewport         String
  confidence       Decimal
  fingerprint      String
  sourceMissions   Json
  sourceMissionTypes Json @default("[]")
  occurrenceCount Int     @default(1)
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt

  audit    Audit             @relation(fields: [auditId], references: [id], onDelete: Cascade)
  evidence FindingEvidence[]
  githubExports FindingGitHubExport[]

  @@index([auditId, fingerprint])
}

model FindingEvidence {
  id        String   @id @default(cuid())
  findingId String
  type      String
  content   String?
  localPath String?
  storageProvider String?
  storageBucket String?
  storagePath String?
  storageContentType String?
  storageSizeBytes Int?
  publicEvidenceId String? @unique
  externalSharingEnabled Boolean @default(false)
  revokedAt DateTime?
  expiresAt DateTime?
  deletionQueuedAt DateTime?
  deletedAt DateTime?
  deletionError String?
  metadata  Json
  createdAt DateTime @default(now())

  finding Finding @relation(fields: [findingId], references: [id], onDelete: Cascade)

  @@index([publicEvidenceId])
  @@index([storageBucket, storagePath])
  @@index([expiresAt])
  @@index([deletedAt])
}

model BillingCustomer {
  id               String   @id @default(cuid())
  workspaceId      String   @unique
  stripeCustomerId String   @unique
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  workspace Organization @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
}

model WorkspaceSubscription {
  id                    String             @id @default(cuid())
  workspaceId           String             @unique
  plan                  CommercialPlan     @default(FREE)
  interval              BillingInterval    @default(MONTHLY)
  status                SubscriptionStatus @default(FREE)
  stripeCustomerId      String?
  stripeSubscriptionId  String?            @unique
  stripePriceId         String?
  latestPaymentStatus   String?
  currentPeriodStart    DateTime?
  currentPeriodEnd      DateTime?
  cancelAtPeriodEnd     Boolean            @default(false)
  trialEndsAt           DateTime?
  canceledAt            DateTime?
  activatedAt           DateTime?
  createdAt             DateTime           @default(now())
  updatedAt             DateTime           @updatedAt

  workspace Organization @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([workspaceId, status])
  @@index([stripeCustomerId])
  @@index([stripePriceId])
}

model BillingWebhookEvent {
  id          String   @id @default(cuid())
  provider    String
  eventId     String
  eventType   String
  processedAt DateTime @default(now())

  @@unique([provider, eventId])
  @@index([eventType])
}

model WorkspaceUsageEvent {
  id             String         @id @default(cuid())
  workspaceId    String
  auditId        String?
  userId         String?
  type           UsageEventType
  quantity       Int            @default(1)
  metadata       Json           @default("{}")
  billingPeriodStart DateTime
  billingPeriodEnd   DateTime
  idempotencyKey String         @unique
  createdAt      DateTime       @default(now())

  workspace Organization @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  audit     Audit?       @relation(fields: [auditId], references: [id], onDelete: Cascade)
  user      User?        @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([workspaceId, billingPeriodStart, billingPeriodEnd])
  @@index([auditId])
  @@index([type])
}

model WorkspaceOnboarding {
  id                    String   @id @default(cuid())
  workspaceId           String   @unique
  welcomeCompletedAt    DateTime?
  workspaceConfirmedAt  DateTime?
  websiteUrl            String?
  websiteValidatedAt    DateTime?
  firstAuditId          String?
  firstAuditStartedAt   DateTime?
  findingsReviewedAt    DateTime?
  githubOfferedAt       DateTime?
  githubConnectedAt     DateTime?
  firstIssueExportedAt  DateTime?
  skippedGitHubAt       DateTime?
  completedAt           DateTime?
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  workspace Organization @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
}

model WorkspaceInvitation {
  id             String           @id @default(cuid())
  workspaceId    String
  email          String
  role           String
  tokenHash      String           @unique
  status         InvitationStatus @default(PENDING)
  invitedByUserId String
  expiresAt      DateTime
  acceptedAt     DateTime?
  revokedAt      DateTime?
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  workspace Organization @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  invitedBy User @relation("WorkspaceInvitationInviter", fields: [invitedByUserId], references: [id], onDelete: Restrict)

  @@index([workspaceId, status])
  @@index([email])
  @@index([expiresAt])
}

model EmailEvent {
  id             String    @id @default(cuid())
  workspaceId    String?
  userId         String?
  recipientEmail String
  template       String
  idempotencyKey String    @unique
  status         String
  provider       String
  providerMessageId String?
  errorMessage   String?
  sentAt         DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([workspaceId])
  @@index([template])
  @@index([status])
}

model WorkspaceAuditLog {
  id          String   @id @default(cuid())
  workspaceId String
  actorUserId String?
  action      String
  metadata    Json     @default("{}")
  createdAt   DateTime @default(now())

  workspace Organization @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([workspaceId, createdAt])
  @@index([action])
}

model WorkspaceDeletionRequest {
  id             String                  @id @default(cuid())
  workspaceId    String
  requestedByUserId String
  confirmation   String
  status         WorkspaceDeletionStatus @default(REQUESTED)
  blockedReason  String?
  scheduledFor   DateTime?
  completedAt    DateTime?
  failedAt       DateTime?
  failureReason  String?
  createdAt      DateTime                @default(now())
  updatedAt      DateTime                @updatedAt

  workspace Organization @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  requestedBy User @relation(fields: [requestedByUserId], references: [id], onDelete: Restrict)

  @@index([workspaceId, status])
}

model Report {
  id        String   @id @default(cuid())
  auditId   String   @unique
  targetUrl String
  generatedAt DateTime @default(now())
  overallScore Int
  severityCounts Json
  categoryCounts Json
  missionSummary Json
  executionWarnings Json
  topFindings Json
  limitations Json
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  audit Audit @relation(fields: [auditId], references: [id], onDelete: Cascade)
}

model GitHubConnection {
  id               String            @id @default(cuid())
  workspaceId      String
  userId           String
  githubAccountId  String
  githubLogin      String
  accountType      GitHubAccountType
  installationId   String
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  revokedAt        DateTime?

  workspace Organization @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user      User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  repositories GitHubRepository[]
  exportBatches GitHubExportBatch[]
  exports FindingGitHubExport[]

  @@unique([workspaceId, installationId])
  @@index([workspaceId])
  @@index([userId])
}

model GitHubAuthState {
  id              String   @id @default(cuid())
  stateHash       String   @unique
  userId          String
  workspaceId     String
  returnUrl       String
  expiresAt       DateTime
  consumedAt      DateTime?
  createdAt       DateTime @default(now())

  user      User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  workspace Organization @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([workspaceId])
  @@index([expiresAt])
}

model GitHubRepository {
  id                  String   @id @default(cuid())
  githubConnectionId  String
  githubRepositoryId  String
  owner               String
  name                String
  fullName            String
  defaultBranch       String?
  private             Boolean  @default(false)
  issuesEnabled       Boolean  @default(false)
  archived            Boolean  @default(false)
  lastSyncedAt        DateTime?
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  githubConnection GitHubConnection @relation(fields: [githubConnectionId], references: [id], onDelete: Cascade)
  exportBatches GitHubExportBatch[]
  exports FindingGitHubExport[]

  @@unique([githubConnectionId, githubRepositoryId])
  @@unique([githubConnectionId, fullName])
  @@index([fullName])
}

model GitHubWebhookDelivery {
  id           String   @id @default(cuid())
  deliveryId   String   @unique
  event        String
  action       String?
  processedAt  DateTime @default(now())

  @@index([event])
}

model GitHubExportBatch {
  id              String                  @id @default(cuid())
  auditId         String
  repositoryId    String
  githubConnectionId String
  requestedCount  Int
  createdCount    Int                     @default(0)
  failedCount     Int                     @default(0)
  skippedCount    Int                     @default(0)
  status          GitHubExportBatchStatus @default(QUEUED)
  exportOptionsJson Json                   @default("{}")
  createdByUserId String
  createdAt       DateTime                @default(now())
  updatedAt       DateTime                @updatedAt
  completedAt     DateTime?

  audit Audit @relation(fields: [auditId], references: [id], onDelete: Cascade)
  repository GitHubRepository @relation(fields: [repositoryId], references: [id], onDelete: Restrict)
  githubConnection GitHubConnection @relation(fields: [githubConnectionId], references: [id], onDelete: Restrict)
  createdBy User @relation(fields: [createdByUserId], references: [id], onDelete: Restrict)
  exports FindingGitHubExport[]

  @@index([auditId])
  @@index([repositoryId])
  @@index([githubConnectionId])
  @@index([status])
}

model FindingGitHubExport {
  id                  String             @id @default(cuid())
  batchId             String?
  auditId             String
  findingId           String
  githubConnectionId  String
  repositoryId        String
  githubIssueNumber   Int?
  githubIssueUrl      String?
  status              GitHubExportStatus @default(QUEUED)
  errorCode           String?
  errorMessage        String?
  idempotencyKey      String             @unique
  createdByUserId     String
  createdAt           DateTime           @default(now())
  updatedAt           DateTime           @updatedAt

  batch GitHubExportBatch? @relation(fields: [batchId], references: [id], onDelete: SetNull)
  audit Audit @relation(fields: [auditId], references: [id], onDelete: Cascade)
  finding Finding @relation(fields: [findingId], references: [id], onDelete: Cascade)
  githubConnection GitHubConnection @relation(fields: [githubConnectionId], references: [id], onDelete: Restrict)
  repository GitHubRepository @relation(fields: [repositoryId], references: [id], onDelete: Restrict)
  createdBy User @relation(fields: [createdByUserId], references: [id], onDelete: Restrict)

  @@index([auditId])
  @@index([findingId])
  @@index([repositoryId])
  @@index([batchId])
  @@index([status])
}
